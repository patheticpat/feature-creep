{
    "id": "jj",
    "version": "1.1.0",
    "name": "Jujutsu (jj)",
    "description": "Installs jj with dynamic zsh completion, mounts the host's ~/.config/jj (user config and per-repo configs) and sets up VS Code for jj (jj-view, built-in git off).",
    "documentationURL": "https://git.adminforge.de/patheticpat/feature-creep",
    "options": {
        "version": {
            "type": "string",
            "proposals": ["latest"],
            "default": "latest",
            "description": "jj version to install, e.g. 0.46.0"
        }
    },
    "mounts": [
        {
            "type": "bind",
            "source": "${localEnv:HOME}/.config/jj",
            "target": "/usr/local/share/jj-host"
        }
    ],
    "customizations": {
        "vscode": {
            "extensions": ["jj-view.jj-view"],
            "settings": {
                "git.enabled": false
            }
        }
    }
}
