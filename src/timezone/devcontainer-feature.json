{
    "id": "timezone",
    "version": "1.0.1",
    "name": "Host time zone",
    "description": "Matches the container's time zone to the host's, using a read-only mount of the host's /etc/localtime.",
    "documentationURL": "https://git.adminforge.de/patheticpat/feature-creep",
    "mounts": [
        "type=bind,source=/etc/localtime,target=/usr/local/share/host-localtime,readonly"
    ],
    "entrypoint": "/usr/local/share/feature-creep/timezone-init.sh"
}
