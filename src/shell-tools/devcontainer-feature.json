{
    "id": "shell-tools",
    "version": "1.3.0",
    "name": "Shell tools",
    "description": "Installs less, man, fzf, ripgrep, fd, bat, starship, zoxide and eza.",
    "documentationURL": "https://github.com/patheticpat/feature-creep",
    "options": {
        "less": { "type": "boolean", "default": true, "description": "Install less" },
        "man": { "type": "boolean", "default": true, "description": "Install man and restore man pages that slim images strip" },
        "fzf": { "type": "boolean", "default": true, "description": "Install fzf" },
        "ripgrep": { "type": "boolean", "default": true, "description": "Install ripgrep (rg)" },
        "fd": { "type": "boolean", "default": true, "description": "Install fd" },
        "bat": { "type": "boolean", "default": true, "description": "Install bat" },
        "starship": { "type": "boolean", "default": true, "description": "Install starship" },
        "zoxide": { "type": "boolean", "default": true, "description": "Install zoxide" },
        "eza": { "type": "boolean", "default": true, "description": "Install eza" }
    }
}
